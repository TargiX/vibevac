{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/WorktreeRemovalPlan",
  "definitions": {
    "WorktreeRemovalPlan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "engine": {
          "$ref": "#/definitions/Engine"
        },
        "engineVersion": {
          "type": "string"
        },
        "force": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignoredFingerprint": {
          "type": "string"
        },
        "workspacePath": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "number"
        },
        "branch": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ]
        },
        "defaultBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastActivityAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "inactiveDays": {
          "type": [
            "number",
            "null"
          ]
        },
        "commonGitDirectory": {
          "type": "string"
        },
        "reconstructionCommand": {
          "type": "string"
        },
        "confirmation": {
          "type": "string"
        }
      },
      "required": [
        "branch",
        "commonGitDirectory",
        "confirmation",
        "defaultBranch",
        "engine",
        "engineVersion",
        "force",
        "head",
        "ignoredFingerprint",
        "inactiveDays",
        "lastActivityAt",
        "reconstructionCommand",
        "schemaVersion",
        "sizeBytes",
        "upstream",
        "warnings",
        "workspacePath"
      ],
      "additionalProperties": false
    },
    "Engine": {
      "type": "string",
      "enum": [
        "node",
        "native"
      ]
    }
  }
}
