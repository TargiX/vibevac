{
  "name": "vibevac",
  "version": "0.2.0",
  "description": "See and safely reclaim rebuildable storage left by AI coding agents: node_modules, Rust target, Python venvs, build caches and stale Git worktrees.",
  "author": "Ilya Moskovkin",
  "license": "MIT",
  "homepage": "https://github.com/TargiX/vibevac#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TargiX/vibevac.git"
  },
  "bugs": {
    "url": "https://github.com/TargiX/vibevac/issues"
  },
  "type": "module",
  "bin": {
    "vibevac": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm build:cli && pnpm build:ui",
    "build:cli": "tsup src/cli.ts --format esm --dts --clean",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev": "tsx src/cli.ts",
    "dev:frontend": "vite --config ui/vite.config.ts",
    "dev:ui": "pnpm build:ui && tsx src/cli.ts ui --no-open",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p ui/tsconfig.json",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "ai",
    "codex",
    "claude-code",
    "cursor",
    "git",
    "worktree",
    "disk-cleanup",
    "developer-tools",
    "vibe-coding",
    "ai-agents",
    "node_modules",
    "disk-space",
    "cleanup",
    "cli",
    "rust",
    "python"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "open": "^10.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@lucide/vue": "^1.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "pnpm@9.12.3",
  "os": [
    "darwin",
    "linux"
  ]
}
